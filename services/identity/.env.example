PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Optional in development (a random key is generated per process).
# Required in production: generate a random secret of at least 32 bytes.
JWT_SECRET=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=carshop_identity
# For external providers: enable TLS when required; use a trusted CA.
MYSQL_SSL=false

