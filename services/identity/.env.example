PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Optional in development (a random key is generated per process).
# Required in production: generate a random secret of at least 32 bytes.
JWT_SECRET=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=carshop_sql
# For external providers: enable TLS when required; use a trusted CA.
MYSQL_SSL=false


# Initial admin (fill locally, do not commit credentials)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
