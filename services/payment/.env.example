PORT=3004
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
# Shared team database (db schema/01_mysql_schema.sql) + database/migrations of this service.
MYSQL_DATABASE=carshop_sql
# For external providers: enable TLS when required; use a trusted CA.
MYSQL_SSL=false
# npm test rebuilds this database every run (name must end with _test).
TEST_MYSQL_DATABASE=carshop_payment_test
SALES_API_URL=http://localhost:3003/api/v1
