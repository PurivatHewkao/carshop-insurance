PORT=3010
NODE_ENV=development
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=nova_insurance
# Alternatively set DATABASE_URL=mysql://user:password@host:3306/nova_insurance
# MYSQL_SSL=true
INSURANCE_FRONTEND_URL=http://localhost:5174
TOYOTY_PUBLIC_URL=http://localhost:5173
# Set 1 only behind Railway's trusted single reverse proxy. Local default: 0
TRUST_PROXY=0
# Insurance: shared with Sales only, at least 32 random characters; never VITE_*.
NOVA_PARTNER_KEY=
# Insurance: one-time admin provisioning via node scripts/create-admin.js.
# NOVA_ADMIN_EMAIL=
# NOVA_ADMIN_PASSWORD=
# Integration tests require a dedicated database with a name ending in _test
# INSURANCE_TEST_DATABASE_URL=mysql://user:password@127.0.0.1:3306/nova_insurance_test
